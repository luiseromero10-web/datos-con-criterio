{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://dcc-portal-five.vercel.app",
          "http://localhost:3000",
          "http://localhost:3100"
        ],
        "methods": [
          "GET",
          "HEAD"
        ],
        "headers": [
          "Range",
          "If-None-Match",
          "If-Modified-Since"
        ]
      },
      "exposeHeaders": [
        "Content-Length",
        "Content-Range",
        "ETag",
        "Accept-Ranges"
      ],
      "maxAgeSeconds": 3600
    }
  ]
}
